# Public contact placeholders. Replace before launch.
NEXT_PUBLIC_COACH_PHONE=
NEXT_PUBLIC_COACH_WECHAT=
NEXT_PUBLIC_COACH_WECHAT_QR=

# GitHub Pages/static export mode. API-backed booking/payment is disabled when true.
NEXT_PUBLIC_STATIC_SITE=false

# Optional site URL used by WeChat notify_url generation.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Coach admin token for /coach and booking confirmation APIs.
COACH_ADMIN_TOKEN=change-this-before-production

# WeChat Pay API v3 credentials.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APPID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=

# Set to true only for local workflow checks without real WeChat credentials.
WECHAT_PAY_MOCK=false
